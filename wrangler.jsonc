{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "disponibilita-ripetizioni",
  "main": "./src/index.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "80831b59a2ea4b4fb325a0fdc7119249"
    }
  ],

  "vars": {
    "TIME_ZONE": "Europe/Rome",
    "WARNING_MINUTES": "30",
    "LOOKAHEAD_DAYS": "14"
  },

  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "ADMIN_TOKEN",
      "STATE_SECRET",
      "TOKEN_ENCRYPTION_KEY"
    ]
  }
}
